# Build output
cpp/build/
build/
cmake-build-*/
*.o
*.a
*.so
compile_commands.json
# IDE
.vs/
.idea/
# Python (only at justified boundaries)
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
# Tests / temp
*.log
*.tmp
*.swp
*~
.DS_Store
# Secrets — never commit
secrets/
*.pem
*.key
*.env
.env.*
# Model weights / large artifacts — never commit
models/
*.gguf
*.safetensors
*.onnx
# NOTE: .phases/ is the HISTORICAL corpus (primary source) — NOT ignored.
/build/artifacts/
/repository/local/
packages/**/*.deb
packages/**/*.changes
packages/**/*.buildinfo

# --- Rebuntu distribution packaging: allow committed build scripts, exclude dh artifacts ---
!scripts/build/
!scripts/build/*
packages/**/debian/generated/
packages/**/debian/debhelper-build-stamp
packages/**/debian/files
packages/**/debian/*.substvars
packages/live/rebuntu-live/debian/rebuntu-live/
