#!/usr/bin/env bash
# `rebuntu` — thin user-facing entry point.
# Dispatches into the native C++ implementation. Contains NO business logic.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="$ROOT/cpp/build/src/rebuntu"
if [[ ! -x "$BIN" ]]; then
  echo "rebuntu: native binary not found at $BIN" >&2
  echo "Build it first:" >&2
  echo "  cd cpp && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build" >&2
  exit 127
fi
exec "$BIN" "$@"
