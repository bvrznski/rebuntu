Window.SetBackgroundTopColor(0.015, 0.018, 0.022);
Window.SetBackgroundBottomColor(0.015, 0.018, 0.022);

logo.image = Image("rebuntu-logo-wordmark.png");
logo.sprite = Sprite(logo.image);

# Scale down only when necessary; preserve aspect ratio.
max_w = Window.GetWidth() * 0.42;
max_h = Window.GetHeight() * 0.62;
scale = 1.0;
if (logo.image.GetWidth() > max_w)
  scale = max_w / logo.image.GetWidth();
if (logo.image.GetHeight() * scale > max_h)
  scale = max_h / logo.image.GetHeight();

logo.image = logo.image.Scale(logo.image.GetWidth() * scale,
                              logo.image.GetHeight() * scale);
logo.sprite.SetImage(logo.image);
logo.sprite.SetX(Window.GetWidth()/2 - logo.image.GetWidth()/2);
logo.sprite.SetY(Window.GetHeight()/2 - logo.image.GetHeight()/2 - Window.GetHeight()*0.035);

bar.width = Window.GetWidth() * 0.22;
bar.height = Math.Max(2, Window.GetHeight() * 0.0025);
bar.x = Window.GetWidth()/2 - bar.width/2;
bar.y = logo.sprite.GetY() + logo.image.GetHeight() + Window.GetHeight()*0.025;

bar.bg.image = Image("bar-bg.png");
bar.bg.image = bar.bg.image.Scale(bar.width, bar.height);
bar.bg.sprite = Sprite(bar.bg.image);
bar.bg.sprite.SetX(bar.x);
bar.bg.sprite.SetY(bar.y);

bar.fill.image = Image("bar-fill.png");
bar.fill.sprite = Sprite(bar.fill.image);
bar.fill.sprite.SetX(bar.x);
bar.fill.sprite.SetY(bar.y);

fun progress_callback(duration, progress) {
  width = Math.Max(1, bar.width * progress);
  fill = bar.fill.image.Scale(width, bar.height);
  bar.fill.sprite.SetImage(fill);
}
Plymouth.SetBootProgressFunction(progress_callback);
