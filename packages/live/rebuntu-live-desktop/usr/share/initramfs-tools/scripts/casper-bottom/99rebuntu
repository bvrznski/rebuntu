#!/bin/sh

PREREQ=""

prereqs()
{
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /scripts/casper-functions

# Casper deliberately removes the live user's password.
# Restore Rebuntu's documented live credentials after Casper user setup.
if chroot /root getent passwd rebuntu >/dev/null 2>&1; then
    printf '%s\n' 'rebuntu:rebuntu' | chroot /root chpasswd
fi

exit 0
