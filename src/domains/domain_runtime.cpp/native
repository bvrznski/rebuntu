DomainApplyResult DomainRuntime::apply(const management::Request&r,bool authorized,bool confirmed){auto start=std::chrono::steady_clock::now();DomainApplyResult out;out.transaction_id="domain-tx-"+std::to_string(++seq_);std::string before;auto prior=state_.get(r.target,r.property);if(prior)before=prior->value;domains::Operation op;try{op=registry_.get(r.domain).plan(r,prior?std::optional<std::string>(before):std::nullopt);}catch(const std::exception&e){out.message=e.what();return out;}planning::ChangePlanner planner;auto plan=planner.plan({"linux-domain",r.target,r.property,r.value,op.command.privileged,r.property=="remove"||r.property=="delete"});policy::Context ctx;ctx.actor="operator";ctx.elevated=authorized;ctx.interactive=confirmed;if(authorized)ctx.capabilities.insert("secrets.write");auto decision=policy_.evaluate(plan,ctx);if(!decision.allowed){out.message=decision.reasons.empty()?"policy denied":decision.reasons.front();return out;}out.accepted=true;auto result=backend_.execute(op.command);out.executed=result.exit_code==0&&!result.timed_out;if(!out.executed){out.message=result.stderr_text.empty()?"execution failed":result.stderr_text;journal_.append({out.transaction_id,"linux-domain",r.target,r.property,before,r.value,"failed"});return out;}out.verified=true;if(op.verify){auto vr=backend_.execute(*op.verify);out.verified=vr.exit_code==0&&!vr.timed_out;if(out.verified&&!op.expected.empty()&&!vr.stdout_text.empty())out.verified=vr.stdout_text.find(op.expected)!=std::string::npos||dynamic_cast<backend::DryRunBackend*>(&backend_)!=nullptr;}if(out.verified){state_.upsert({r.target,r.property,r.value,"linux-domain-runtime",1.0});out.message="applied and verified";}else{out.message="verification failed";if(op.rollback)backend_.execute(*op.rollback);}journal_.append({out.transaction_id,"linux-domain",r.target,r.property,before,r.value,out.verified?"committed":"rolled-back"});telemetry_.record({{},"domain-runtime","apply",r.target,out.verified,std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now()-start),{{"property",r.property}}});return out;}
std::map<std::string,backend::Result> DomainRuntime::inspect(management::Domain d,const std::string&t){std::map<std::string,backend::Result> out;for(const auto&p:registry_.get(d).probes(t))out[p.key]=backend_.execute(p.command);return out;}
